{
  "manifest_version": 1,
  "type": "provider",
  "name": "DeepL",
  "description": {
    "en": "Unofficial: translate texts in your scenes with your DeepL API key (Free or Pro).",
    "fr": "Non officiel : traduisez des textes dans vos scènes avec votre clé d'API DeepL (Free ou Pro)."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/lm1lc3n7/gladys-deepl:0.1.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/LM1LC3N7/gladys-deepl/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "DeepL translation in your scenes",
        "fr": "Traduction DeepL dans vos scènes"
      },
      "description": {
        "en": "Unofficial connector, not affiliated with DeepL. The \"Translate (DeepL)\" scene action translates a text and gives the translation to the next actions of the scene (to send it, speak it…). Create a DeepL API account on deepl.com (API Free: 500,000 characters a month at no cost; API Pro: billed per character) and copy its authentication key here. DeepL is called only by the scene action and the check button, never at start nor on a timer. Never tested with a real DeepL key yet.",
        "fr": "Connecteur non officiel, sans lien avec DeepL. L'action de scène « Traduire (DeepL) » traduit un texte et donne la traduction aux actions suivantes de la scène (pour l'envoyer, la lire à voix haute…). Créez un compte DeepL API sur deepl.com (API Free : 500 000 caractères par mois sans frais ; API Pro : facturé au caractère) et copiez ici sa clé d'authentification. DeepL n'est appelé que par l'action de scène et le bouton de vérification, jamais au démarrage ni sur une minuterie. Jamais testé avec une vraie clé DeepL pour l'instant."
      },
      "links": [
        {
          "url": "https://www.deepl.com/pro-api",
          "label": {
            "en": "DeepL API plans",
            "fr": "Offres DeepL API"
          }
        },
        {
          "url": "https://www.deepl.com/your-account/keys",
          "label": {
            "en": "Your DeepL API keys",
            "fr": "Vos clés d'API DeepL"
          }
        },
        {
          "url": "https://github.com/LM1LC3N7/gladys-deepl/blob/main/docs/fr.md",
          "label": {
            "en": "Guide (French)",
            "fr": "Guide (français)"
          }
        },
        {
          "url": "https://github.com/LM1LC3N7/gladys-deepl/blob/main/docs/en.md",
          "label": {
            "en": "Guide (English)",
            "fr": "Guide (anglais)"
          }
        }
      ]
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "DeepL API authentication key",
        "fr": "Clé d'authentification DeepL API"
      },
      "description": {
        "en": "Kept by Gladys in its database, never shown again, sent only to DeepL (api-free.deepl.com for a Free key ending in \":fx\", api.deepl.com otherwise).",
        "fr": "Gardée par Gladys dans sa base, jamais réaffichée, envoyée seulement à DeepL (api-free.deepl.com pour une clé Free finissant par « :fx », api.deepl.com sinon)."
      },
      "required": true
    },
    {
      "key": "max_chars_per_call",
      "type": "number",
      "label": {
        "en": "Maximum characters per translation",
        "fr": "Nombre maximal de caractères par traduction"
      },
      "description": {
        "en": "A longer text is refused, never cut (1 to 5000). Spaces and punctuation count, as on DeepL's bill.",
        "fr": "Un texte plus long est refusé, jamais coupé (de 1 à 5000). Espaces et ponctuation comptent, comme sur la facture DeepL."
      },
      "required": false,
      "default": 1000,
      "min": 1,
      "max": 5000
    },
    {
      "key": "max_chars_per_day",
      "type": "number",
      "label": {
        "en": "Maximum characters over 24 hours",
        "fr": "Nombre maximal de caractères sur 24 heures"
      },
      "description": {
        "en": "Safety cap against a runaway scene, on a rolling 24 hours, kept across a restart (100 to 1000000). Counted before each request; beyond it, nothing is sent and the scene action fails. 10,000 a day stays under 310,000 a month.",
        "fr": "Plafond de sécurité contre une scène qui s'emballe, sur 24 heures glissantes, gardé au redémarrage (de 100 à 1000000). Compté avant chaque requête ; au-delà, rien n'est envoyé et l'action de scène échoue. 10 000 par jour restent sous 310 000 par mois."
      },
      "required": false,
      "default": 10000,
      "min": 100,
      "max": 1000000
    }
  ],
  "actions": [
    {
      "key": "check_account",
      "timeout_seconds": 20,
      "label": {
        "en": "Check the key",
        "fr": "Vérifier la clé"
      },
      "description": {
        "en": "Asks DeepL whether it accepts the key, with the characters used this billing period (counts no character).",
        "fr": "Demande à DeepL s'il accepte la clé, avec les caractères consommés sur la période de facturation (ne compte aucun caractère)."
      }
    }
  ],
  "scene_actions": [
    {
      "key": "translate",
      "label": {
        "en": "Translate (DeepL)",
        "fr": "Traduire (DeepL)"
      },
      "description": {
        "en": "Translates the text through DeepL (counted in the caps, billed on a Pro key). Never tried again when DeepL does not answer.",
        "fr": "Traduit le texte avec DeepL (compté dans les plafonds, facturé avec une clé Pro). Jamais renvoyé quand DeepL ne répond pas."
      },
      "timeout_seconds": 45,
